# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase configuration. Prefer the current sb_secret_ key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Deprecated fallback for maintenance scripts only.
SUPABASE_SERVICE_ROLE_KEY=

# Kakao OIDC server configuration
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# Optional. When empty, the current origin callback is used.
KAKAO_OIDC_REDIRECT_URI=

# Server-only manual refund account encryption.
REFUND_ACCOUNT_ENCRYPTION_KEYS=
REFUND_ACCOUNT_ACTIVE_KEY_VERSION=1
REFUND_ACCOUNT_FINGERPRINT_KEY=

# Mobile storefront feature controls
MOBILE_SITE_ENABLED=true
MOBILE_AUTO_REDIRECT_ENABLED=true

DEV_ALLOWED_ORIGINS=

LOCAL_TEST_ACCOUNTS_ENABLED=false
LOCAL_TEST_ACCOUNT_PASSWORD=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

OPENROUTER_API_KEY=
CRON_SECRET=

# Upstash Redis Rate Limiting (입찰/장바구니 API 방어)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

PAYOUT_ACCOUNT_ENCRYPTION_KEY=

# 멀티 클라우드 스토리지 각 프로바이더의 용량 한도(Byte, 0 = 무제한). Supabase 1GB & Cloudflare R2 10GB 핑퐁 롤오버.
MULTICLOUD_DEFAULT_CAPACITY_BYTES=107374182400
MULTICLOUD_SUPABASE_CAPACITY_BYTES=1073741824        # 1GB
MULTICLOUD_R2_CAPACITY_BYTES=10737418240           # 10GB
MULTICLOUD_PRODUCT_IMAGE_BUCKET=product-images

# Cloudflare R2 인증 정보 (필수)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_DOMAIN=

PORTONE_STORE_ID=
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=
PORTONE_CHANNEL_MODE=
VITE_PORTONE_STORE_ID=
VITE_PORTONE_CHANNEL_KEY=
VITE_PORTONE_CARD_CHANNEL_KEY=
VITE_PORTONE_KAKAOPAY_CHANNEL_KEY=
VITE_PORTONE_VIRTUAL_ACCOUNT_CHANNEL_KEY=
VITE_PORTONE_WEBHOOK_URL=
