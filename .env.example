# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase configuration. Prefer the current sb_secret_ key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Deprecated fallback for maintenance scripts only.
SUPABASE_SERVICE_ROLE_KEY=

# Kakao OIDC server configuration
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# Optional. When empty, the current origin callback is used.
KAKAO_OIDC_REDIRECT_URI=

# Server-only manual refund account encryption.
# JSON object of version -> base64-encoded 32-byte AES key.
REFUND_ACCOUNT_ENCRYPTION_KEYS=
REFUND_ACCOUNT_ACTIVE_KEY_VERSION=1
# Independent base64-encoded key (at least 32 bytes) used for HMAC fingerprints.
REFUND_ACCOUNT_FINGERPRINT_KEY=

# Mobile storefront feature controls
MOBILE_SITE_ENABLED=true
MOBILE_AUTO_REDIRECT_ENABLED=true

# Comma-delimited local network origins, for example:
# DEV_ALLOWED_ORIGINS=http://192.168.0.10:3000,http://localhost:3000
DEV_ALLOWED_ORIGINS=

# Dormant local-only test account switch. Keep false in normal development
# and every deployment. `npm run dev:local-test` enables this only for its
# isolated local Supabase process.
LOCAL_TEST_ACCOUNTS_ENABLED=false
LOCAL_TEST_ACCOUNT_PASSWORD=

# Archived PortOne adapter settings. The active payment mode is hard-disabled
# in src/lib/commerce/paymentMode.ts; do not configure these in production
# unless a reviewed reactivation changes that server-side flag first.
PORTONE_STORE_ID=
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=
PORTONE_CHANNEL_MODE=
VITE_PORTONE_STORE_ID=
VITE_PORTONE_CHANNEL_KEY=
VITE_PORTONE_CARD_CHANNEL_KEY=
VITE_PORTONE_KAKAOPAY_CHANNEL_KEY=
VITE_PORTONE_VIRTUAL_ACCOUNT_CHANNEL_KEY=
VITE_PORTONE_WEBHOOK_URL=
