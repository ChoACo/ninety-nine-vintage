{
  "name": "ninety-nine-homepage",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "next build --webpack",
    "dev": "next dev",
    "start": "next start",
    "storage:configure:r2-cors": "node scripts/configure-r2-cors.mjs",
    "storage:delete:migrated-supabase": "node scripts/delete-migrated-supabase-storage.mjs",
    "storage:migrate:r2": "node scripts/migrate-storage-to-r2.mjs",
    "storage:migrate:r2:dry-run": "node scripts/migrate-storage-to-r2.mjs --dry-run",
    "storage:repair:r2-references:dry-run": "node scripts/repair-r2-url-references.mjs",
    "test": "node --test tests/core/*.test.mjs",
    "verify:browser": "node scripts/verify-local-browser-happy-path.mjs",
    "verify:central-fulfillment-db": "node scripts/verify-local-central-fulfillment-postgres.mjs",
    "verify:central-fulfillment-db:docker": "node scripts/verify-docker-central-fulfillment-postgres.mjs",
    "verify:central-fulfillment-intake-db": "node scripts/verify-local-central-fulfillment-intake-postgres.mjs",
    "verify:canonical-shipment-db:docker": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-canonical-commerce-shipment.ps1",
    "verify:store-membership-db": "node scripts/verify-local-store-membership-postgres.mjs",
    "verify:integrations": "node scripts/verify-integrations.mjs",
    "verify:local": "node scripts/verify-local-happy-path.mjs",
    "verify:migrations": "node scripts/verify-migration-parity.mjs",
    "verify:published-products-db": "node scripts/verify-local-published-product-management-postgres.mjs",
    "verify:queue-snapshot-db": "node scripts/verify-local-queue-snapshot-postgres.mjs",
    "verify:reversal-target-db": "node scripts/verify-local-reversal-target-postgres.mjs",
    "verify:reversal-target-db:docker": "node scripts/verify-docker-reversal-target-postgres.mjs",
    "db:reset-local": "node scripts/local-test-supabase.mjs reset",
    "dev:local-test": "node scripts/start-local-test-app.mjs",
    "lint": "eslint .",
    "deploy": "vercel --prod"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1118.0",
    "@aws-sdk/s3-request-presigner": "3.1118.0",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@supabase/supabase-js": "2.110.6",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "embla-carousel-react": "^8.6.0",
    "exceljs": "4.4.0",
    "framer-motion": "^13.1.1",
    "lucide-react": "1.25.0",
    "next": "16.2.11",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "sharp": "0.35.3",
    "web-push": "3.6.7",
    "zod": "^4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.0",
    "@tailwindcss/postcss": "4.2.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "3.6.4",
    "esbuild": "0.28.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.4",
    "typescript": "5.9.3"
  },
  "overrides": {
    "exceljs": {
      "archiver": "8.0.0",
      "unzipper": "0.12.5"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "2.1.4"
    },
    "minimatch@9.0.9": {
      "brace-expansion": "2.1.4"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.9"
    },
    "postcss": "8.5.26",
    "sharp": "0.35.3",
    "uuid": "11.1.1"
  },
  "type": "module"
}
