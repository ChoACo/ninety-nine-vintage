{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "cloudflare-worker.mjs",
	"name": "ninety-nine-homepage",
	"compatibility_date": "2026-07-25",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"workers_dev": false,
	"preview_urls": false,
	"secrets": {
		"required": [
			"GEMINI_API_KEY",
			"SUPABASE_SECRET_KEY",
			"KAKAO_REST_API_KEY",
			"KAKAO_CLIENT_SECRET"
		]
	},
	"routes": [
		{
			"pattern": "ninety-nine-vintage.store",
			"custom_domain": true
		},
		{
			"pattern": "www.ninety-nine-vintage.store/*",
			"zone_name": "ninety-nine-vintage.store"
		}
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS",
		"run_worker_first": [
			"/*",
			"!/_next/*"
		]
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "ninety-nine-homepage"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	}
}
